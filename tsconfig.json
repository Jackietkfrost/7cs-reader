{
    "include": ["src/*.ts", "src/*.d.ts", "src/renderer", "src/**/*.vue"],
    "compilerOptions": {
        "baseUrl": "./",
        "outDir": "./dist",
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "jsx": "preserve",
        "noImplicitAny": false,
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["esnext", "dom"]
    },
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
